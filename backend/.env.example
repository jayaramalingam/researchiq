# ResearchIQ Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/researchiq

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
# Required to enable AI paper analysis and cross-paper synthesis.
# Get a free API key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use for analysis. Free models available at https://openrouter.ai/models?q=free
# Default: meta-llama/llama-3.1-8b-instruct:free  (free, no cost)
# Other good free options:
#   mistralai/mistral-7b-instruct:free
#   google/gemma-3-12b-it:free
#   qwen/qwen3-8b:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Timeout in seconds for OpenRouter API calls (default: 60)
OPENROUTER_TIMEOUT=60

# ── Semantic Scholar ──────────────────────────────────────────────────────────
# Optional: leave blank to use the public (rate-limited) endpoint.
# Request a key at https://www.semanticscholar.org/product/api#api-key-form
# A key raises rate limits significantly.
SEMANTIC_SCHOLAR_API_KEY=

# Timeout in seconds for Semantic Scholar API calls (default: 20)
SEMANTIC_SCHOLAR_TIMEOUT=20
